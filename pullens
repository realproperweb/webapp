        Get a Free Quote
      </a>
      <a href="#services" class="btn-outline">View Our Work</a>
    </div>
  </div>
  <div class="hero-scroll">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<!-- ═══════════════════════ SERVICES ═══════════════════════ -->
<section id="services">
  <div class="section-inner">
